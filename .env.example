# Copie para .env e exporte as variáveis (ou configure no seu servidor/Docker).
PORT=8080
DB_PATH=promo.db
# Mínimo de 16 caracteres. Sem isso, o painel /admin fica desligado.
ADMIN_TOKEN=
ALLOW_PUBLIC_POSTS=false
COLLECT_INTERVAL_HOURS=6
COLLECT_ON_START=true
MIN_DISCOUNT_PERCENT=10

# Sem nenhuma credencial abaixo, o servidor roda em modo demo (ofertas de exemplo).
# DEMO_MODE=true

# Natura e O Boticário (Awin): URL do feed de produtos gerada no painel da Awin (Create-a-Feed)
# AWIN_FEED_NATURA_URL=
# AWIN_FEED_BOTICARIO_URL=

# Shopee Afiliados (Open API)
# SHOPEE_APP_ID=
# SHOPEE_APP_SECRET=
# SHOPEE_KEYWORDS=perfume,fone bluetooth

# Amazon (Creators API)
# AMAZON_CREDENTIAL_ID=
# AMAZON_CREDENTIAL_SECRET=
# AMAZON_PARTNER_TAG=seutag-20
# AMAZON_KEYWORDS=fone bluetooth,air fryer
# AMAZON_MARKETPLACE=www.amazon.com.br

# Mercado Livre (app em developers.mercadolivre.com.br)
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=
# ML_ITEM_IDS=MLB123456789,MLB987654321
# ML_SEARCH_TERMS=notebook,smart tv
# ML_AFFILIATE_URL_TEMPLATE={url}?seu_parametro_de_afiliado=valor

# Leitura das páginas públicas das lojas (sem afiliado). Copie sites.example.json para sites.json e ajuste.
# SCRAPE_SITES_FILE=sites.json
# SCRAPER_CONTACT=https://seu-site.com/contato-do-robo
# SCRAPER_MIN_DELAY_MS=3000

# Link do app passando pelo servidor (conta cliques e deixa trocar o destino sem atualizar o app).
# PUBLIC_BASE_URL=https://api.seudominio.com
# Atrás de proxy (Caddy/Nginx), ative para o limite por IP usar o IP real.
# TRUST_PROXY=true
# Apaga ofertas expiradas há mais de N dias e limita requisições por minuto por IP (0 desliga).
# RETENTION_DAYS=60
# RATE_LIMIT_PER_MINUTE=120
# Usado pelo docker-compose
# DOMAIN=api.seudominio.com

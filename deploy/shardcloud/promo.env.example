# Configuração do servidor na ShardCloud. Copie para promo.env (na raiz do projeto) e preencha.
# Este arquivo vai dentro do ZIP e contém segredos: não publique no GitHub.

# A ShardCloud exige que servidores web escutem na porta 80.
PORT=80

# O disco persistente da aplicação fica em /app.
DB_PATH=/app/data/promo.db
SCRAPE_SITES_FILE=/app/sites.json

# Segredo do painel /admin. Mínimo de 16 caracteres (gere algo aleatório). Sem isso o painel fica desligado.
ADMIN_TOKEN=

# Endereço HTTPS da aplicação: https://SEU-SUBDOMINIO.shardweb.app (o mesmo SUBDOMAIN do arquivo .shardcloud). Sem barra no final.
PUBLIC_BASE_URL=https://meupromoapp.shardweb.app
TRUST_PROXY=true

COLLECT_INTERVAL_HOURS=6
MIN_DISCOUNT_PERCENT=10
RETENTION_DAYS=60
RATE_LIMIT_PER_MINUTE=120
SCRAPER_CONTACT=

# Credenciais das lojas (opcional). Sem nenhuma, o servidor roda em modo demo.
# AWIN_FEED_NATURA_URL=
# AWIN_FEED_BOTICARIO_URL=
# SHOPEE_APP_ID=
# SHOPEE_APP_SECRET=
# AMAZON_CREDENTIAL_ID=
# AMAZON_CREDENTIAL_SECRET=
# AMAZON_PARTNER_TAG=
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=
